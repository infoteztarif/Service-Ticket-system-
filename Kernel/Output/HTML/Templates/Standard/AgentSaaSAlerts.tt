<div class="MainBox ARIARoleMain TeztarifAdminPage">
    <div class="TeztarifReportHeading">
        <div>
            <h1>My Task &amp; Ticket Alerts</h1>
            <p>Only tickets assigned to you in your company. SLA deadlines shown in UTC.</p>
        </div>
        <a href="[% Env('Baselink') %]Action=AgentSaaSAlerts" class="CallForAction">Refresh alerts</a>
    </div>
    <div class="WidgetSimple">
        <div class="Header"><h2>Active notifications ([% Data.AlertCount | html %])</h2></div>
        <div class="Content">
            <p>New assigned tickets (last 24 hours), SLA due within 24 hours and overdue SLA tickets are shown here.</p>
            <p><strong>Notifications refresh when you open or refresh this page.</strong> Background push alerts are not enabled yet.</p>
            <div class="TeztarifAlertsList">
                [% RenderBlockStart("SaaSTicketAlertRow") %]
                <article class="TeztarifAlertCard">
                    <div class="TeztarifAlertTitle">
                        <a href="[% Env('Baselink') %]Action=AgentTicketZoom;TicketID=[% Data.TicketID | uri %]">[% Data.Title | html %]</a>
                        <strong>[% Data.Type | html %]</strong>
                    </div>
                    <div>Ticket #[% Data.TicketID | html %] &middot; [% Data.State | html %]</div>
                    <div>Created: [% Data.Created | html %] UTC &middot; SLA deadline: [% Data.DeadlineUTC | html %]</div>
                </article>
                [% RenderBlockEnd("SaaSTicketAlertRow") %]
            </div>
            [% IF Data.AlertCount == 0 %]
            <p>No new or due alerts in the current window.</p>
            [% END %]
        </div>
    </div>
</div>
